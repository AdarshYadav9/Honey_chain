          <div style={{ position: 'fixed', top: '20px', left: '50%', transform: 'translateX(-50%)', background: 'var(--amber-500)', color: 'var(--bg-dark)', padding: '12px 24px', borderRadius: '8px', zIndex: 9999, fontWeight: 'bold' }}>
            🔔 {notification}
          </div>
        )}


        {/* ================= 1. OVERVIEW VIEW ================= */}
        <section className={`view-pane ${activeView === 'overview' ? 'active' : ''}`} id="view-overview">
          
          {/* PUBLIC MARKETING OVERVIEW */}
          {!currentUser && (
            <>
              <div className="hero-grid">
                <div className="hero-content">
                  <div className="eyebrow-badge">
                    <Sparkles size={13} /> KVIC Honey Mission Prototype
                  </div>
