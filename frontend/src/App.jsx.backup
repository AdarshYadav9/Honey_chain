import React, { useState, useEffect, useMemo, useCallback } from 'react';
import './App.css';
import { QRCodeCanvas } from 'qrcode.react';
import {
  Cpu,
  ShieldCheck,
  Search,
  Layers,
  Award,
  TrendingUp,
  Sparkles,
  Thermometer,
  Droplets,
  Scale,
  Radio,
  Battery,
  CheckCircle2,
  AlertTriangle,
  Sun,
  Moon,
  Copy,
  ChevronRight,
  MapPin,
  Activity,
  FileCheck,
  Settings,
  Eye,
  EyeOff,
  Leaf,
  LineChart,
  Users,
  QrCode,
  Shield,
  User,
  CheckCircle,
  Cog
} from 'lucide-react';

// Initial Hive dataset
const initialHives = {
  H001: { loc: 'Satara Cluster, Maharashtra', temp: 34.2, hum: 61, wt: 31.5, act: 'Normal (240Hz)', batt: 82, health: 'HEALTHY', state: 'ok' },
  H002: { loc: 'Kolhapur Apiary, Maharashtra', temp: 37.1, hum: 58, wt: 22.4, act: 'Elevated (430Hz)', batt: 64, health: 'WATCH (High Temp)', state: 'warn' },
  H003: { loc: 'Muzaffarpur Litchi Belt, Bihar', temp: 33.8, hum: 60, wt: 28.9, act: 'Normal (235Hz)', batt: 91, health: 'HEALTHY', state: 'ok' },
  H004: { loc: 'Sundarbans Mangrove, West Bengal', temp: 34.6, hum: 62, wt: 19.7, act: 'Normal (250Hz)', batt: 18, health: 'LOW BATTERY', state: 'low' },
  H005: { loc: 'Hoshiarpur Mustard, Punjab', temp: 33.5, hum: 57, wt: 33.1, act: 'Normal (245Hz)', batt: 88, health: 'HEALTHY', state: 'ok' },
};

// Flow steps
const flowSteps = [
  { n: '01', t: 'IoT Hive Pack', d: 'LoRaWAN node samples temp, humidity, scale weight & acoustic buzzing spectrum every 3 min.', view: 'monitor' },
  { n: '02', t: 'AI Edge Engine', d: 'AI analyzes hive conditions for colony-stress and anomaly risk, while forecasting honey yield.', view: 'ai' },
  { n: '03', t: 'Blockchain Hash', d: 'Harvest GPS, lab purity & cold extraction events are immutably sealed on-ledger.', view: 'chain' },
  { n: '04', t: 'QR Serialization', d: 'Each glass jar receives a cryptographically linked dynamic QR code seal.', view: 'qr' },
  { n: '05', t: 'Consumer Verify', d: 'Shoppers scan to view NMR 99.4% purity, apiary coordinates & beekeeper story.', view: 'qr' }
];

// Blockchain stages
const chainStages = [
  { s: 'HARVEST', t: 'Apiary Collection', rows: ['Beekeeper: Ganesh Pawar', 'Hive H001, Satara Cluster', '14 Apr 2026, 07:40 IST'], hash: '0x8f2c19a0e14d5cb79' },
  { s: 'LAB TEST', t: 'NMR & Purity Gate', rows: ['NMR Score: 98.6%', 'Moisture: 17.2%', 'C4 Sugar: NEGATIVE (0%)'], hash: '0x3ba7e0291df445ea1' },
  { s: 'PROCESSING', t: 'Cold Extraction', rows: ['Satara Cold Unit (Unheated)', 'Sediment Micro-mesh Filtered', '16 Apr 2026'], hash: '0x9e14d5c8821034bc2' },
  { s: 'PACKAGING', t: 'Glass Bottling', rows: ['Batch KVIC-HC-2026-0417', 'Jars Sealed: 240 units', '18 Apr 2026'], hash: '0x71fbc889a0b12cf34' },
  { s: 'LOGISTICS', t: 'KVIC Depot Link', rows: ['Regional Hub Dispatch', 'Cold-chain tracked', '20 Apr 2026'], hash: '0xd402a91e55b8921a4' },
  { s: 'RETAIL', t: 'Khadi Bhandar Store', rows: ['Certified Store Shelf', 'QR Live for Authentication', '22 Apr 2026'], hash: '0xe94a1b6c0032f918e' }
];

// Clusters for scale-up hex map
const clusters = ['Satara', 'Kolhapur', 'Muzaffarpur', 'Sundarbans', 'Nashik', 'Pune', 'Hoshiarpur', 'Ratnagiri', 'Nagpur', 'Nanded'];
const hexPath = 'M26 1 L49 14 L49 40 L26 53 L3 40 L3 14 Z';

export default function App() {
  const [theme, setTheme] = useState('light');
  const [activeView, setActiveView] = useState('overview');
  const [hives, setHives] = useState(initialHives);
  const [activeHive, setActiveHive] = useState('HIVE-BOX-01');
  const [batchIdInput, setBatchIdInput] = useState('KVIC-HC-2026-0417');
  const [isScanned, setIsScanned] = useState(false);
  const [showFullCertModal, setShowFullCertModal] = useState(false);
  
  // Auth State
  const [currentUser, setCurrentUser] = useState(null);
  const [loginEmail, setLoginEmail] = useState('');
  const [loginError, setLoginError] = useState('');
  const [showPassword, setShowPassword] = useState(false);

  // Shared Prototype Data
  const [sharedBatches, setSharedBatches] = useState([]);
  const [notification, setNotification] = useState(null);

  const showNotification = (msg) => {
    setNotification(msg);
    setTimeout(() => setNotification(null), 4000);
  };

  const fetchBatches = async () => {
    try {
      const res = await fetch('http://localhost:4000/api/batches');
      const data = await res.json();
      if (data.ok) setSharedBatches(data.batches);
    } catch (err) {}
  };

  useEffect(() => {
    fetchBatches();
    const iv = setInterval(fetchBatches, 3000); // Polling for demo sync
    return () => clearInterval(iv);
  }, []);

  const handleLogin = async (e) => {
    e.preventDefault();
    setLoginError('');
    try {
      const res = await fetch('http://localhost:4000/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email: loginEmail })
      });
      const data = await res.json();
      if (data.ok) {
        setCurrentUser(data.user);
        setActiveView('overview');
      } else {
        setLoginError(data.error);
      }
    } catch (err) {
      setLoginError('Login failed. Is backend running?');
    }
  };

  const handleRegisterHarvest = async (e) => {
    e.preventDefault();
    const honeyType = e.target.elements.honeyType.value;
    const quantity = parseFloat(e.target.elements.harvestQty.value);
    const harvestDate = e.target.elements.harvestDate.value;
    
    try {
      const res = await fetch('http://localhost:4000/api/batches', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ hiveId: activeHive, honeyType, quantity, harvestDate })
      });
      const data = await res.json();
      if (data.ok) {
        showNotification(`Batch ${data.batch.id} created!`);
        fetchBatches();
        setActiveView('overview');
      }
    } catch (err) {}
  };

  const handleVerifyBatch = async (batchId) => {
    try {
      await fetch(`http://localhost:4000/api/batches/${batchId}/verify`, { method: 'POST' });
      showNotification(`Batch ${batchId} verified!`);
      fetchBatches();
    } catch(err) {}
  };

  const handleQualitySubmit = async (e, batchId) => {
    e.preventDefault();
    try {
      await fetch(`http://localhost:4000/api/batches/${batchId}/quality`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          moisture: e.target.elements.moisture.value,
          purity: e.target.elements.purity.value,
          hmf: e.target.elements.hmf.value,
          result: e.target.elements.result.value
        })
      });
      showNotification(`Quality metrics submitted for ${batchId}`);
      fetchBatches();
    } catch(err) {}
  };

  const handleProcessSubmit = async (e, batchId) => {
    e.preventDefault();
    try {
      await fetch(`http://localhost:4000/api/batches/${batchId}/process`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          center: e.target.elements.center.value,
          qtyProcessed: e.target.elements.qtyProcessed.value
        })
      });
      showNotification(`Batch ${batchId} processed!`);
      fetchBatches();
    } catch(err) {}
  };

  const handlePackageSubmit = async (batchId) => {
    try {
      await fetch(`http://localhost:4000/api/batches/${batchId}/package`, { method: 'POST' });
      showNotification(`Batch ${batchId} packaged & QR generated!`);
      fetchBatches();
    } catch(err) {}
  };
  
  // Dynamic Data States
  const [dashboardStats, setDashboardStats] = useState(null);
  const [ledger, setLedger] = useState(null);

  const [activePopover, setActivePopover] = useState(null);
  const [productionRange, setProductionRange] = useState('30');

  const recentAlerts = [
    { id: 'H024', msg: 'Humidity above normal', val: '72%', time: '8 min ago', level: 'WARNING' },
    { id: 'H031', msg: 'Weight trend unusually low', val: '-0.8 kg', time: '21 min ago', level: 'WARNING' },
    { id: 'H011', msg: 'Hive conditions stabilized', val: '34.1 °C', time: '14 min ago', level: 'RESOLVED' },
    { id: 'H018', msg: 'Abnormal activity pattern detected', val: 'Activity index 41%', time: '32 min ago', level: 'WARNING' }
  ];

  const latestBatch = {
    id: "HC-MH-2026-00124",
    honeyType: "Wildflower Honey",
    hiveId: "H001",
    quantity: 8.4,
    harvestDate: "12 Aug 2026",
    qualityStatus: "Verified",
    blockchainStatus: "Recorded"
  };

  // Fetch dynamic data on mount
  useEffect(() => {
    fetch('http://localhost:4000/api/iot/hives')
      .then(res => res.json())
      .then(data => {
        if (data.ok && data.hives && data.hives.length > 0) {
          const hivesMap = {};
          data.hives.forEach(h => {
             hivesMap[h.hiveId] = {
               loc: h.location,
               temp: h.telemetry.internalTemp,
               hum: h.telemetry.humidity,
               wt: h.telemetry.weightKg,
               wtDelta: h.telemetry.weightDelta24h || '+0.0 kg',
               act: h.telemetry.acousticFreqHz > 400 ? `Elevated (${h.telemetry.acousticFreqHz}Hz)` : `Normal (${h.telemetry.acousticFreqHz}Hz)`,
               batt: h.telemetry.batteryLevel,
               co2: h.telemetry.co2Ppm,
               floral: h.floralSource,
               queen: h.queenStatus,
               health: h.colonyHealth,
               state: h.colonyHealth === 'EXCELLENT' ? 'ok' : h.colonyHealth === 'WARNING' ? 'warn' : 'low'
             };
          });
          setHives(hivesMap);
          if (!hivesMap[activeHive]) {
            setActiveHive(Object.keys(hivesMap)[0]);
          }
        }
      }).catch(err => console.error("Error fetching hives:", err));

    fetch('http://localhost:4000/api/kvic/dashboard')
      .then(res => res.json())
      .then(data => {
        if (data.ok && data.stats) setDashboardStats(data.stats);
      }).catch(err => console.error("Error fetching dashboard:", err));

    fetch('http://localhost:4000/api/ledger')
      .then(res => res.json())
      .then(data => {
        if (data.ok && data.blockchain) setLedger(data.blockchain);
      }).catch(err => console.error("Error fetching ledger:", err));
  }, []);

  // Sync theme attribute to HTML root
  useEffect(() => {
    document.documentElement.setAttribute('data-theme', theme);
  }, [theme]);

  // Switch views and scroll to top
  const switchView = (viewName) => {
    setActiveView(viewName);
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // Live telemetry jitter interval for active hive
  useEffect(() => {
    const timer = setInterval(() => {
      setHives(prev => {
        const cur = prev[activeHive];
        if (!cur) return prev;
        const newTemp = cur.temp + (Math.random() - 0.5) * 0.15;
        const newHum = cur.hum + (Math.random() - 0.5) * 0.5;
        const newWt = cur.wt + Math.random() * 0.02;
        return {
          ...prev,
          [activeHive]: {
            ...cur,
            temp: Math.round(newTemp * 10) / 10,
            hum: Math.round(newHum * 10) / 10,
            wt: Math.round(newWt * 10) / 10
          }
        };
      });
    }, 3000);
    return () => clearInterval(timer);
  }, [activeHive]);

  const curHive = hives[activeHive] || Object.values(hives)[0] || initialHives.H001;

  // Generate sparkline series
  const tempSeriesData = useMemo(() => {
    return Array.from({ length: 24 }, (_, i) => (curHive.temp || 34.0) + Math.sin(i / 3) * 1.4 + (Math.random() - 0.5) * 0.6);
  }, [curHive.temp]);

  const weightSeriesData = useMemo(() => {
    return Array.from({ length: 24 }, (_, i) => (curHive.wt || 30.0) - 1.8 + i * (1.8 / 23) + (Math.random() - 0.5) * 0.15);
  }, [curHive.wt]);

  // Sparkline SVG generator with smooth curves
  const renderSparkline = useCallback((data, strokeColor, fillColor) => {
    const w = 320;
    const h = 90;
    const pad = 10;
    const min = Math.min(...data);
    const max = Math.max(...data);
    const range = max - min || 1;

    const pts = data.map((v, i) => {
      const x = pad + (i * (w - 2 * pad)) / (data.length - 1);
      const y = h - pad - ((v - min) / range) * (h - 2 * pad);
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    }).join(' ');

    const areaPts = `${pad},${h - pad} ${pts} ${w - pad},${h - pad}`;

    return (
      <>
        <polyline points={areaPts} fill={fillColor || 'var(--amber-500)'} opacity="0.15" />
        <polyline points={pts} fill="none" stroke={strokeColor || 'var(--amber-400)'} strokeWidth="2.5" strokeLinecap="round" strokeLinejoin="round" />
      </>
    );
  }, []);

  // AI Yield Chart SVG
  const yieldChartSvg = useMemo(() => {
    const w = 400;
    const h = 180;
    const pad = 26;
    const pred = [30, 33.4, 37.1, 41.2];
    const upper = pred.map(v => v + 2.4);
    const lower = pred.map(v => v - 2.4);
    const xAt = i => pad + (i * (w - 2 * pad)) / (pred.length - 1);
    const min = Math.min(...lower);
    const max = Math.max(...upper);
    const range = max - min || 1;
    const yAt = v => h - pad - ((v - min) / range) * (h - 2 * pad);

    const band = `M ${xAt(0)},${yAt(upper[0])} L ${upper.map((v, i) => `${xAt(i)},${yAt(v)}`).join(' L ')} L ${lower.slice().reverse().map((v, i) => `${xAt(pred.length - 1 - i)},${yAt(v)}`).join(' L ')} Z`;
    const line = `M ${xAt(0)},${yAt(pred[0])} L ${pred.map((v, i) => `${xAt(i)},${yAt(v)}`).join(' L ')}`;
    const labels = ['Week 1', 'Week 2', 'Week 3', 'Week 4'];

    return (
      <>
        <path d={band} fill="var(--amber-500)" opacity="0.12" />
        <path d={line} fill="none" stroke="var(--amber-400)" strokeWidth="2.8" />
        {pred.map((v, i) => (
          <circle key={i} cx={xAt(i)} cy={yAt(v)} r="4" fill="var(--amber-400)" />
        ))}
        {labels.map((l, i) => (
          <text key={i} x={xAt(i)} y={h - 6} fontSize="11" fill="var(--text-muted)" textAnchor="middle" fontFamily="JetBrains Mono">
            {l}
          </text>
        ))}
      </>
    );
  }, []);

  if (activeView === 'login') {
    return (
      <div className="login-page-wrapper">
        <header className="login-global-header">
          <div className="login-brand">
            <svg width="24" height="24" viewBox="0 0 40 40" fill="none">
              <polygon points="20,2 35,11 35,29 20,38 5,29 5,11" fill="var(--amber-500)" />
              <polygon points="20,8 29,13 29,27 20,32 11,27 11,13" fill="var(--bg-dark)" />
              <path d="M20 13 L20 27 M14 17 L26 17 M14 23 L26 23" stroke="var(--amber-400)" strokeWidth="1.6" />
            </svg>
            <div className="login-brand-text">
              <div className="login-name">Honey Chain</div>
              <div className="login-tag">KVIC HONEY MISSION • BLOCKCHAIN &amp; AIOT</div>
            </div>
          </div>
          <div className="login-header-right">
            Building a sweeter, more transparent tomorrow
            <Leaf size={14} className="leaf-icon" style={{ marginLeft: '6px' }} />
          </div>
        </header>

        <div className="login-split-container">
          <div className="login-hero-pane">
            <div className="login-hero-overlay"></div>
            <div className="login-hero-content">
              <div className="login-hero-tags">
                <span># PURE HONEY</span>
                <span># RURAL LIVELIHOODS</span>
                <span># TRUSTED ORIGIN</span>
              </div>
              <h1 className="login-hero-title">
                From Hive<br />to a <span className="gold-highlight">Healthier</span> World
              </h1>
              <p className="login-hero-desc">
                Empowering rural beekeepers with IoT, AI and blockchain for transparent, traceable and authentic honey.
              </p>
              <div className="login-hero-features">
                <div className="lh-feature"><Leaf size={20} /><span>Support<br/>Beekeepers</span></div>
                <div className="lh-feature"><LineChart size={20} /><span>AI-Powered<br/>Monitoring</span></div>
                <div className="lh-feature"><Shield size={20} /><span>Blockchain<br/>Traceability</span></div>
                <div className="lh-feature"><Users size={20} /><span>Authentic<br/>Honey for All</span></div>
              </div>
              <div className="login-hero-quote">
                "Authentic honey. Stronger communities.<br/>A more sustainable tomorrow."
                <div className="quote-author">KVIC HONEY MISSION</div>
              </div>
            </div>
            <div className="login-hero-bottom-bar">
              <div className="lh-stats-grid">
                <div className="lh-stat-item"><Leaf size={16}/><div>Rural<br/>Empowerment</div></div>
                <div className="lh-stat-item"><Users size={16}/><div>Sustainable<br/>Livelihoods</div></div>
                <div className="lh-stat-item"><ShieldCheck size={16}/><div>Transparent<br/>Supply Chain</div></div>
                <div className="lh-stat-item"><CheckCircle size={16}/><div>Healthier<br/>Consumers</div></div>
              </div>
              <div className="lh-stat-summary">
                <span>1,000+ Hives</span> | <span>100+ Beekeepers</span> | <span>One Trusted Ecosystem</span>
              </div>
              <div className="lh-slogan">For a<br/>Sweeter Tomorrow</div>
            </div>
          </div>

          <div className="login-form-pane">
            <div className="login-card">
              <div className="lc-header">
                <div className="lc-welcome">Welcome to</div>
                <div className="lc-brand">Honey Chain</div>
                <div className="lc-mission">KVIC HONEY MISSION</div>
                <div className="lc-subtitle">Sign in to access your Honey Chain dashboard</div>
              </div>

              <form onSubmit={handleLogin} className="lc-form">
                <div className="lc-input-group">
                  <label>Email / Mobile Number</label>
                  <input type="text" placeholder="Enter your email or mobile number" value={loginEmail} onChange={e => setLoginEmail(e.target.value)} required />
                </div>
                <div className="lc-input-group">
                  <label>Password</label>
                  <div className="lc-password-wrapper">
                    <input type={showPassword ? 'text' : 'password'} placeholder="Enter your password" required />
                    <button type="button" className="lc-pw-toggle" onClick={() => setShowPassword(!showPassword)}>
                      {showPassword ? <EyeOff size={18} /> : <Eye size={18} />}
                    </button>
                  </div>
                </div>
                
                <div className="lc-form-options">
                  <label className="lc-checkbox">
                    <input type="checkbox" defaultChecked /> Remember me
                  </label>
                  <a href="#" className="lc-forgot" onClick={(e) => { e.preventDefault(); alert('Password reset is not enabled in this prototype.'); }}>Forgot password?</a>
                </div>

                {loginError && <div className="lc-error">{loginError}</div>}
                
                <button type="submit" className="lc-submit-btn">
                  Sign In <ChevronRight size={18} />
                </button>
              </form>

              <div className="lc-divider"><span>OR</span></div>
              
              <button className="lc-consumer-btn" onClick={() => setActiveView('qr')}>
                <QrCode size={18} />
                <div className="lc-cb-text">
                  <span>Continue as Consumer</span>
                  <small>Scan QR code to verify a product (No login required)</small>
                </div>
              </button>

              <div className="lc-demo-creds">
                <div className="lc-dc-title">Demo Credentials (For Prototype)</div>
                <div className="lc-dc-grid">
                  <div className="lc-dc-card" onClick={() => setLoginEmail('admin@honeychain.demo')}>
                    <div className="dc-role"><Award size={14}/> ADMIN</div>
                    <div className="dc-email">admin@honeychain.demo <Copy size={12}/></div>
                    <div className="dc-badge badge-admin">Full Access</div>
                  </div>
                  <div className="lc-dc-card" onClick={() => setLoginEmail('beekeeper@honeychain.demo')}>
                    <div className="dc-role"><User size={14}/> BEEKEEPER</div>
                    <div className="dc-email">beekeeper@honeychain.demo <Copy size={12}/></div>
                    <div className="dc-badge badge-bk">Manage Hives & Batches</div>
                  </div>
                  <div className="lc-dc-card" onClick={() => setLoginEmail('officer@honeychain.demo')}>
                    <div className="dc-role"><ShieldCheck size={14}/> QUALITY OFFICER</div>
                    <div className="dc-email">officer@honeychain.demo <Copy size={12}/></div>
                    <div className="dc-badge badge-qo">Verify & Approve</div>
                  </div>
                  <div className="lc-dc-card" onClick={() => setLoginEmail('processor@honeychain.demo')}>
                    <div className="dc-role"><Cog size={14}/> PROCESSOR</div>
                    <div className="dc-email">processor@honeychain.demo <Copy size={12}/></div>
                    <div className="dc-badge badge-proc">Process & Package</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="app-container">
      <div className="comb-overlay"></div>

      {/* Header Bar */}
      <header className="app-header">
        <div className="headbar">
          {/* Left: Brand Logo & Title */}
          <div className="brand" onClick={() => switchView('overview')}>
            <div className="brand-icon-wrap">
              <svg width="24" height="24" viewBox="0 0 40 40" fill="none">
                <polygon points="20,2 35,11 35,29 20,38 5,29 5,11" fill="var(--amber-500)" />
                <polygon points="20,8 29,13 29,27 20,32 11,27 11,13" fill="var(--bg-dark)" />
                <path d="M20 13 L20 27 M14 17 L26 17 M14 23 L26 23" stroke="var(--amber-400)" strokeWidth="1.6" />
              </svg>
            </div>
            <div className="brand-text">
              <div className="name">Honey Chain</div>
              <div className="tag">KVIC HONEY MISSION • BLOCKCHAIN &amp; AI IOT</div>
            </div>
          </div>

          {/* Center: Navigation Tabs */}
          <nav className="nav-tabs" id="tabs">
            {/* PUBLIC MODE */}
            {!currentUser && (
              <>
                <button className={`tab-button ${activeView === 'overview' ? 'active' : ''}`} onClick={() => switchView('overview')}>
                  <Award size={15} /> Overview
                </button>
                <button className={`tab-button ${activeView === 'monitor' ? 'active' : ''}`} onClick={() => switchView('monitor')}>
                  <Cpu size={15} /> Hive Monitor
                </button>
                <button className={`tab-button ${activeView === 'ai' ? 'active' : ''}`} onClick={() => switchView('ai')}>
                  <Sparkles size={15} /> AI Insights
                </button>
                <button className={`tab-button ${activeView === 'chain' ? 'active' : ''}`} onClick={() => switchView('chain')}>
                  <Layers size={15} /> Blockchain Trace
                </button>
                <button className={`tab-button ${activeView === 'qr' ? 'active' : ''}`} onClick={() => switchView('qr')}>
                  <Search size={15} /> Consumer Scan
                </button>
                <button className={`tab-button ${activeView === 'scale' ? 'active' : ''}`} onClick={() => switchView('scale')}>
                  <TrendingUp size={15} /> Scale-Up Plan
                </button>
              </>
            )}

            {/* AUTHENTICATED MODE */}
            {currentUser && (
              <button className={`tab-button ${activeView === 'overview' ? 'active' : ''}`} onClick={() => switchView('overview')}>
