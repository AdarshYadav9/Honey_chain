            {currentUser && currentUser.role === 'PROCESSOR' && (
              <button className={`tab-button ${activeView === 'proc-batches' ? 'active' : ''}`} onClick={() => alert('Mock: Processed batches coming soon!')}>
                <Layers size={15} /> Batches
