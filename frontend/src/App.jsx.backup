                <Cpu size={15} /> Hive Monitor
              </button>
            )}

            {currentUser && (currentUser.role === 'ADMIN' || currentUser.role === 'BEEKEEPER') && (
              <button className={`tab-button ${activeView === 'ai' ? 'active' : ''}`} onClick={() => switchView('ai')}>
                <Sparkles size={15} /> AI Insights
              </button>
