                  <rect x="25" y="30" width="50" height="40" fill="var(--amber-500)" opacity="0.2" rx="4" />
                  <rect x="20" y="25" width="60" height="8" fill="var(--amber-400)" rx="2" />
                  <rect x="22" y="38" width="56" height="4" fill="var(--amber-500)" opacity="0.4" />
                  <rect x="22" y="48" width="56" height="4" fill="var(--amber-500)" opacity="0.4" />
                  <rect x="22" y="58" width="56" height="4" fill="var(--amber-500)" opacity="0.4" />
                  <circle cx="50" cy="15" r="4" fill="var(--emerald-400)" />
                  <path d="M50 15 L50 25" stroke="var(--emerald-400)" strokeWidth="2" />
                </svg>
              </div>
            </div>

            {/* MAIN CONTENT AREA */}
            <div className="monitor-main-area">
              
              {/* 2. MAIN HEADER */}
              <div className="mm-header-card glass-card">
                <div className="mm-h-top">
                  <div>
                    <h2 style={{ fontSize: '24px', margin: '0 0 4px', display: 'flex', alignItems: 'center', gap: '10px' }}>
                      Hive {activeHive}
                      <span className="mm-badge-online">Online</span>
                    </h2>
                    <div style={{ color: 'var(--text-muted)', fontSize: '13.5px' }}>
                      {activeHive === 'H001' ? 'Satara Apiary Cluster, Maharashtra' : curHive?.loc || 'Satara Apiary Cluster, Maharashtra'} • Beekeeper: Rajesh Patil • Installed: 12 Jan 2026
                    </div>
                  </div>
                  <button className="btn-luxury btn-luxury-primary" onClick={() => alert('Mock: Export Data triggered')}>
                    Export Data
                  </button>
                </div>
                <div className="mm-filters">
                  <span className="mm-filter active">Live</span>
                  <span className="mm-filter">24H</span>
                  <span className="mm-filter">7D</span>
                  <span className="mm-filter">30D</span>
                  <span className="mm-filter">Custom</span>
                </div>
              </div>

              {/* 7. STATUS BLOCK */}
              <div className="mm-status-strip">
                <div className="mm-ss-item"><CheckCircle2 size={16} color="var(--emerald-400)" /> Online</div>
                <div className="mm-ss-item"><CheckCircle2 size={16} color="var(--emerald-400)" /> Healthy</div>
                <div className="mm-ss-item"><CheckCircle2 size={16} color="var(--emerald-400)" /> No abnormal acoustic patterns detected</div>
                <div className="mm-ss-item"><Radio size={16} color="var(--emerald-400)" /> IoT Connected</div>
              </div>

              {/* 3. LIVE SENSOR CARDS (6 grid) */}
              <div className="mm-sensor-grid">
                <div className="mm-sensor-card">
                  <div className="mm-sc-label"><Thermometer size={14} /> Temperature</div>
                  <div className="mm-sc-val">{(curHive.temp || 34.8).toFixed(1)}°C</div>
                  <div className="mm-sc-trend">
                    <svg viewBox="0 0 100 20" className="mm-sc-spark">
                       <polyline points="0,15 20,10 40,12 60,8 80,5 100,7" fill="none" stroke="var(--emerald-400)" strokeWidth="2" strokeLinecap="round" />
                    </svg>
                  </div>
                </div>
                <div className="mm-sensor-card">
                  <div className="mm-sc-label"><Droplets size={14} /> Humidity</div>
                  <div className="mm-sc-val">{Math.round(curHive.hum || 63)}%</div>
                  <div className="mm-sc-trend">
                    <svg viewBox="0 0 100 20" className="mm-sc-spark">
                       <polyline points="0,5 20,8 40,6 60,10 80,12 100,8" fill="none" stroke="var(--emerald-400)" strokeWidth="2" strokeLinecap="round" />
                    </svg>
                  </div>
                </div>
                <div className="mm-sensor-card">
                  <div className="mm-sc-label"><Scale size={14} /> Hive Weight</div>
                  <div className="mm-sc-val">{(curHive.wt || 34.1).toFixed(1)} kg</div>
                  <div className="mm-sc-trend">
                    <svg viewBox="0 0 100 20" className="mm-sc-spark">
                       <polyline points="0,18 20,16 40,12 60,8 80,4 100,2" fill="none" stroke="var(--emerald-400)" strokeWidth="2" strokeLinecap="round" />
                    </svg>
                  </div>
                </div>
                <div className="mm-sensor-card">
                  <div className="mm-sc-label"><Radio size={14} /> Acoustic Buzz</div>
                  <div className="mm-sc-val" style={{ fontSize: '18px' }}>Normal</div>
                  <div className="mm-sc-trend">
                    <svg viewBox="0 0 100 20" className="mm-sc-spark">
                       <polyline points="0,10 15,10 20,2 25,18 30,10 80,10 85,5 90,15 95,10 100,10" fill="none" stroke="var(--amber-400)" strokeWidth="2" strokeLinecap="round" />
                    </svg>
                  </div>
                </div>
                <div className="mm-sensor-card">
                  <div className="mm-sc-label"><Battery size={14} /> Battery</div>
                  <div className="mm-sc-val">{Math.round(curHive.batt || 88)}%</div>
                  <div className="mm-sc-trend">
                    <svg viewBox="0 0 100 20" className="mm-sc-spark">
                       <polyline points="0,5 50,5 100,5" fill="none" stroke="var(--emerald-400)" strokeWidth="2" strokeLinecap="round" />
                    </svg>
                  </div>
                </div>
                <div className="mm-sensor-card">
                  <div className="mm-sc-label"><Activity size={14} /> Signal Strength</div>
                  <div className="mm-sc-val" style={{ fontSize: '18px' }}>Strong</div>
                  <div className="mm-sc-trend">
                    <svg viewBox="0 0 100 20" className="mm-sc-spark">
                       <polyline points="0,20 10,20 10,15 30,15 30,10 50,10 50,5 70,5 70,2 90,2 90,0 100,0" fill="none" stroke="var(--emerald-400)" strokeWidth="2" strokeLinecap="round" />
                    </svg>
                  </div>
                </div>
              </div>

              {/* 4. CHARTS */}
              <div className="mm-charts-row">
                <div className="mm-chart-box glass-card">
                  <div className="mm-cb-title">Environmental Trends (24H)</div>
                  <svg viewBox="0 0 400 120" width="100%" height="120">
                     {/* Temp Line */}
                     <path d="M 0,80 Q 50,40 100,50 T 200,30 T 300,50 T 400,20" fill="none" stroke="var(--amber-400)" strokeWidth="3" />
                     {/* Humidity Line */}
                     <path d="M 0,60 Q 50,80 100,70 T 200,90 T 300,70 T 400,100" fill="none" stroke="var(--emerald-400)" strokeWidth="3" />
                  </svg>
                  <div className="mm-cb-legend">
                    <span><span style={{ color: 'var(--amber-400)' }}>—</span> Temperature</span>
                    <span><span style={{ color: 'var(--emerald-400)' }}>—</span> Humidity</span>
                  </div>
                </div>
                <div className="mm-chart-box glass-card">
                  <div className="mm-cb-title">Hive Weight Trend (30D)</div>
                  <svg viewBox="0 0 400 120" width="100%" height="120">
                     <path d="M 0,100 L 50,95 L 100,85 L 150,88 L 200,60 L 250,55 L 300,30 L 350,25 L 400,10" fill="none" stroke="var(--amber-400)" strokeWidth="3" />
                     <path d="M 0,100 L 50,95 L 100,85 L 150,88 L 200,60 L 250,55 L 300,30 L 350,25 L 400,10 L 400,120 L 0,120 Z" fill="var(--amber-500)" opacity="0.1" />
                  </svg>
                </div>
                <div className="mm-chart-box glass-card">
                  <div className="mm-cb-title">Acoustic Activity (24H)</div>
                  <svg viewBox="0 0 400 120" width="100%" height="120">
                     {Array.from({length: 24}).map((_, i) => (
                       <rect key={i} x={i * (400/24) + 4} y={120 - (40 + Math.random() * 40)} width={(400/24) - 8} height={40 + Math.random() * 40} fill="var(--amber-400)" opacity="0.8" rx="2" />
                     ))}
                  </svg>
                </div>
              </div>

              {/* 5. RECENT DATA & 6. ALERTS TIMELINE */}
              <div className="mm-bottom-grid">
                <div className="mm-table-card glass-card">
                  <div className="mm-cb-title">Recent Telemetry</div>
                  <table className="mm-table">
                    <thead>
                      <tr>
                        <th>Time</th>
                        <th>Temp</th>
                        <th>Hum</th>
                        <th>Weight</th>
                        <th>Batt</th>
                        <th>Status</th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr><td>Just now</td><td>34.8°C</td><td>63%</td><td>34.1 kg</td><td>88%</td><td className="status-ok">Healthy</td></tr>
                      <tr><td>3 mins ago</td><td>34.7°C</td><td>63%</td><td>34.1 kg</td><td>88%</td><td className="status-ok">Healthy</td></tr>
                      <tr><td>6 mins ago</td><td>34.7°C</td><td>62%</td><td>34.1 kg</td><td>88%</td><td className="status-ok">Healthy</td></tr>
                      <tr><td>9 mins ago</td><td>34.6°C</td><td>62%</td><td>34.0 kg</td><td>88%</td><td className="status-ok">Healthy</td></tr>
                      <tr><td>12 mins ago</td><td>34.6°C</td><td>63%</td><td>34.0 kg</td><td>88%</td><td className="status-ok">Healthy</td></tr>
                    </tbody>
                  </table>
                </div>

                <div className="mm-timeline-card glass-card">
                  <div className="mm-cb-title">Hive Events & Alerts</div>
                  <div className="mm-timeline">
                    <div className="mm-tl-item">
                      <div className="mm-tl-dot ok"></div>
                      <div className="mm-tl-content">
                        <div className="mm-tl-time">2 mins ago</div>
                        <div className="mm-tl-desc">Data synced successfully</div>
                      </div>
                    </div>
                    <div className="mm-tl-item">
                      <div className="mm-tl-dot ok"></div>
                      <div className="mm-tl-content">
                        <div className="mm-tl-time">1 hr ago</div>
                        <div className="mm-tl-desc">Routine health check completed</div>
                      </div>
                    </div>
                    <div className="mm-tl-item">
                      <div className="mm-tl-dot ok"></div>
                      <div className="mm-tl-content">
                        <div className="mm-tl-time">4 hrs ago</div>
                        <div className="mm-tl-desc">Temperature within normal range</div>
                      </div>
                    </div>
                    <div className="mm-tl-item">
                      <div className="mm-tl-dot info"></div>
                      <div className="mm-tl-content">
                        <div className="mm-tl-time">12 hrs ago</div>
                        <div className="mm-tl-desc">Weight increased by +0.2kg</div>
                      </div>
                    </div>
                    <div className="mm-tl-item">
                      <div className="mm-tl-dot ok"></div>
                      <div className="mm-tl-content">
                        <div className="mm-tl-time">1 day ago</div>
                        <div className="mm-tl-desc">Battery level normal</div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
              
              {/* BEEKEEPER: Register Harvest */}
              {currentUser?.role === 'BEEKEEPER' && (
                <div className="glass-card" style={{ marginTop: '24px', borderTop: '2px solid var(--amber-500)' }}>
                  <h4 style={{ marginBottom: '16px', fontSize: '16px', color: 'var(--amber-400)' }}>Register Honey Harvest</h4>
                  <form onSubmit={handleRegisterHarvest} style={{ display: 'grid', gridTemplateColumns: '1fr 1fr 1fr auto', gap: '16px', alignItems: 'end' }}>
                    <div>
                      <label style={{ display: 'block', fontSize: '12px', marginBottom: '8px', color: 'var(--text-muted)' }}>Honey Type</label>
                      <select style={{ width: '100%', padding: '12px', background: 'rgba(0,0,0,0.2)', border: '1px solid var(--border-subtle)', borderRadius: '6px', color: 'var(--text-main)' }} id="honeyType">
                        <option value="Wildflower Honey">Wildflower Honey</option>
                        <option value="Acacia Honey">Acacia Honey</option>
                        <option value="Mustard Honey">Mustard Honey</option>
                      </select>
                    </div>
                    <div>
                      <label style={{ display: 'block', fontSize: '12px', marginBottom: '8px', color: 'var(--text-muted)' }}>Quantity (kg)</label>
                      <input type="number" id="harvestQty" defaultValue={8.4} step="0.1" required style={{ width: '100%', padding: '12px', background: 'rgba(0,0,0,0.2)', border: '1px solid var(--border-subtle)', borderRadius: '6px', color: 'var(--text-main)' }} />
                    </div>
                    <div>
                      <label style={{ display: 'block', fontSize: '12px', marginBottom: '8px', color: 'var(--text-muted)' }}>Harvest Date</label>
                      <input type="date" id="harvestDate" defaultValue={new Date().toISOString().split('T')[0]} required style={{ width: '100%', padding: '12px', background: 'rgba(0,0,0,0.2)', border: '1px solid var(--border-subtle)', borderRadius: '6px', color: 'var(--text-main)' }} />
                    </div>
                    <button type="submit" className="btn-luxury btn-luxury-primary" style={{ padding: '12px 24px', height: '45px' }}>Create Batch</button>
                  </form>
                </div>
              )}

            </div>
          </div>
        </section>

        {/* ================= 3. QUALITY OFFICER VIEW ================= */}
        <section className={`view-pane ${activeView === 'quality' ? 'active' : ''}`} id="view-quality">
          <div className="flow-title-row">
            <div className="eyebrow-badge"><ShieldCheck size={13} /> Quality Assurance</div>
            <h2 style={{ fontSize: '30px' }}>Pending Verifications & Quality Testing</h2>
          </div>
          
          <div style={{ display: 'grid', gridTemplateColumns: '1fr', gap: '24px' }}>
            {sharedBatches.filter(b => b.status === 'HARVEST_CREATED' || b.status === 'HARVEST_VERIFIED').map(batch => (
              <div key={batch.id} className="glass-card">
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '16px' }}>
                  <div>
                    <h3 style={{ margin: 0, color: 'var(--amber-400)' }}>Batch: {batch.id}</h3>
                    <div style={{ fontSize: '13px', color: 'var(--text-muted)', marginTop: '4px' }}>
                      Hive: {batch.hiveId} • Type: {batch.honeyType} • Qty: {batch.quantity}kg
                    </div>
                  </div>
                  <div className="status-badge" style={{ background: 'rgba(255,255,255,0.1)', padding: '6px 12px', borderRadius: '4px', fontSize: '12px' }}>
                    {batch.status}
                  </div>
                </div>
                
                {batch.status === 'HARVEST_CREATED' && (
                  <button onClick={() => handleVerifyBatch(batch.id)} className="btn-luxury btn-luxury-primary" style={{ padding: '10px 20px' }}>
                    Approve Harvest Registration
                  </button>
                )}

                {batch.status === 'HARVEST_VERIFIED' && (
                  <form onSubmit={(e) => handleQualitySubmit(e, batch.id)} style={{ background: 'rgba(0,0,0,0.2)', padding: '20px', borderRadius: '8px', display: 'grid', gridTemplateColumns: '1fr 1fr 1fr 1fr auto', gap: '16px', alignItems: 'end' }}>
                    <div>
                      <label style={{ display: 'block', fontSize: '12px', marginBottom: '8px', color: 'var(--text-muted)' }}>Moisture (%)</label>
                      <input type="number" id="moisture" defaultValue={17.2} step="0.1" style={{ width: '100%', padding: '10px', background: 'var(--bg-dark)', border: '1px solid var(--border-subtle)', borderRadius: '6px', color: 'var(--text-main)' }} />
                    </div>
                    <div>
                      <label style={{ display: 'block', fontSize: '12px', marginBottom: '8px', color: 'var(--text-muted)' }}>Purity NMR (%)</label>
                      <input type="number" id="purity" defaultValue={99.4} step="0.1" style={{ width: '100%', padding: '10px', background: 'var(--bg-dark)', border: '1px solid var(--border-subtle)', borderRadius: '6px', color: 'var(--text-main)' }} />
                    </div>
                    <div>
                      <label style={{ display: 'block', fontSize: '12px', marginBottom: '8px', color: 'var(--text-muted)' }}>HMF (mg/kg)</label>
                      <input type="number" id="hmf" defaultValue={14} style={{ width: '100%', padding: '10px', background: 'var(--bg-dark)', border: '1px solid var(--border-subtle)', borderRadius: '6px', color: 'var(--text-main)' }} />
                    </div>
                    <div>
                      <label style={{ display: 'block', fontSize: '12px', marginBottom: '8px', color: 'var(--text-muted)' }}>Result</label>
                      <select id="result" style={{ width: '100%', padding: '10px', background: 'var(--bg-dark)', border: '1px solid var(--border-subtle)', borderRadius: '6px', color: 'var(--text-main)' }}>
                        <option value="PASS">PASS</option>
                        <option value="FAIL">FAIL</option>
                      </select>
                    </div>
                    <button type="submit" className="btn-luxury btn-luxury-primary" style={{ padding: '10px 16px', height: '42px' }}>Submit Test</button>
                  </form>
                )}
              </div>
            ))}
            {sharedBatches.filter(b => b.status === 'HARVEST_CREATED' || b.status === 'HARVEST_VERIFIED').length === 0 && (
              <div style={{ padding: '40px', textAlign: 'center', color: 'var(--text-muted)' }}>No pending verifications at this time.</div>
            )}
          </div>
        </section>

        {/* ================= 4. PROCESSOR VIEW ================= */}
        <section className={`view-pane ${activeView === 'processing' ? 'active' : ''}`} id="view-processing">
          <div className="flow-title-row">
            <div className="eyebrow-badge"><Layers size={13} /> Processing Unit</div>
            <h2 style={{ fontSize: '30px' }}>Batches Ready for Processing</h2>
          </div>
          
          <div style={{ display: 'grid', gridTemplateColumns: '1fr', gap: '24px' }}>
            {sharedBatches.filter(b => b.status === 'QUALITY_VERIFIED' || b.status === 'PROCESSED').map(batch => (
              <div key={batch.id} className="glass-card">
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '16px' }}>
                  <div>
                    <h3 style={{ margin: 0, color: 'var(--amber-400)' }}>Batch: {batch.id}</h3>
                    <div style={{ fontSize: '13px', color: 'var(--text-muted)', marginTop: '4px' }}>
                      Hive: {batch.hiveId} • Type: {batch.honeyType} • Qty: {batch.quantity}kg
                    </div>
                  </div>
                  <div className="status-badge" style={{ background: 'rgba(255,255,255,0.1)', padding: '6px 12px', borderRadius: '4px', fontSize: '12px' }}>
                    {batch.status}
                  </div>
                </div>

                {batch.status === 'QUALITY_VERIFIED' && (
                  <form onSubmit={(e) => handleProcessSubmit(e, batch.id)} style={{ background: 'rgba(0,0,0,0.2)', padding: '20px', borderRadius: '8px', display: 'grid', gridTemplateColumns: '1fr 1fr auto', gap: '16px', alignItems: 'end' }}>
                    <div>
                      <label style={{ display: 'block', fontSize: '12px', marginBottom: '8px', color: 'var(--text-muted)' }}>Processing Center</label>
                      <input type="text" id="center" defaultValue="Satara Processing Unit" readOnly style={{ width: '100%', padding: '10px', background: 'var(--bg-dark)', border: '1px solid var(--border-subtle)', borderRadius: '6px', color: 'var(--text-muted)' }} />
                    </div>
                    <div>
                      <label style={{ display: 'block', fontSize: '12px', marginBottom: '8px', color: 'var(--text-muted)' }}>Quantity Processed (kg)</label>
                      <input type="number" id="qtyProcessed" defaultValue={batch.quantity} step="0.1" style={{ width: '100%', padding: '10px', background: 'var(--bg-dark)', border: '1px solid var(--border-subtle)', borderRadius: '6px', color: 'var(--text-main)' }} />
                    </div>
                    <button type="submit" className="btn-luxury btn-luxury-primary" style={{ padding: '10px 16px', height: '42px' }}>Complete Processing</button>
                  </form>
                )}

                {batch.status === 'PROCESSED' && (
                  <button onClick={() => handlePackageSubmit(batch.id)} className="btn-luxury btn-luxury-primary" style={{ padding: '10px 20px', background: 'var(--emerald-500)', borderColor: 'var(--emerald-400)', color: 'white' }}>
                    Mark as Packaged & Generate QR
                  </button>
                )}
              </div>
            ))}
            {sharedBatches.filter(b => b.status === 'QUALITY_VERIFIED' || b.status === 'PROCESSED').length === 0 && (
              <div style={{ padding: '40px', textAlign: 'center', color: 'var(--text-muted)' }}>No batches currently queued for processing.</div>
            )}
          </div>
        </section>

        {/* ================= 3. AI INSIGHTS VIEW ================= */}
        <section className={`view-pane ${activeView === 'ai' ? 'active' : ''}`} id="view-ai">
          <div className="flow-title-row">
            <div className="eyebrow-badge"><Sparkles size={13} /> Machine Learning Disease &amp; Yield Engine</div>
            <h2 style={{ fontSize: '30px' }}>AI Colony Diagnostics &amp; Harvest Forecast</h2>
            <p className="section-lede">
              Fuses real-time acoustic frequency harmonics, brood temperature variance, and inspection photos to identify diseases early and forecast honey extraction volume.
            </p>
          </div>

          <div className="ai-dual-col">
            {/* Colony Health Score Card */}
            <div className="glass-card">
              <h3 style={{ fontSize: '20px', marginBottom: '18px' }}>Colony Health Index</h3>
              <div className="score-hero-row">
                <svg width="120" height="120" viewBox="0 0 120 120">
                  <circle cx="60" cy="60" r="50" stroke="rgba(255,255,255,0.08)" strokeWidth="12" fill="none" />
                  <circle
                    cx="60"
                    cy="60"
                    r="50"
                    stroke="var(--emerald-400)"
                    strokeWidth="12"
                    fill="none"
                    strokeLinecap="round"
                    strokeDasharray="314"
                    strokeDashoffset="26"
                    transform="rotate(-90 60 60)"
                  />
                </svg>
                <div>
                  <div className="score-big-num">92<span style={{ fontSize: '22px', color: 'var(--text-muted)' }}>/100</span></div>
                  <div style={{ fontSize: '13px', color: 'var(--text-muted)', marginTop: '4px' }}>
                    Derived from brood thermal stability, foraging activity &amp; acoustic harmonics.
                  </div>
                </div>
              </div>

              <div className="risk-progress-row">
                <div className="risk-label-bar">
                  <span>Varroa Mite Infestation Risk</span>
                  <span className="mono" style={{ color: 'var(--emerald-400)' }}>8%</span>
                </div>
                <div className="progress-track"><div className="progress-fill" style={{ width: '8%' }}></div></div>
              </div>

              <div className="risk-progress-row">
                <div className="risk-label-bar">
                  <span>Foulbrood (AFB/EFB) Bacterial Risk</span>
                  <span className="mono" style={{ color: 'var(--emerald-400)' }}>3%</span>
                </div>
                <div className="progress-track"><div className="progress-fill" style={{ width: '3%' }}></div></div>
              </div>

              <div className="risk-progress-row">
                <div className="risk-label-bar">
                  <span>Nosema Fungal Spore Risk</span>
                  <span className="mono" style={{ color: 'var(--emerald-400)' }}>5%</span>
                </div>
                <div className="progress-track"><div className="progress-fill" style={{ width: '5%' }}></div></div>
              </div>

              <div className="ai-recommend-box">
                <strong>AI Agronomist Recommendation:</strong> All biological and acoustic indicators are in optimal green status. Continue regular 6-day inspections; no chemical or formic acid treatment required.
              </div>
            </div>

            {/* AI Yield Prediction Card */}
            <div className="glass-card">
              <h3 style={{ fontSize: '20px', marginBottom: '10px' }}>4-Week Honey Yield Forecast</h3>
              <p style={{ fontSize: '13px', color: 'var(--text-muted)', marginBottom: '16px' }}>
                Projected harvest accumulation calculated from current scale delta and regional floral bloom calendar.
              </p>
              <svg viewBox="0 0 400 180" width="100%" height="180">
                {yieldChartSvg}
              </svg>
              <div style={{ display: 'flex', gap: '20px', marginTop: '12px', fontSize: '12.5px', color: 'var(--text-muted)' }}>
                <span><span style={{ display: 'inline-block', width: '9px', height: '9px', background: 'var(--amber-400)', borderRadius: '50%', marginRight: '6px' }}></span>Predicted Yield Curve</span>
                <span><span style={{ display: 'inline-block', width: '9px', height: '9px', background: 'rgba(245,158,11,0.25)', borderRadius: '50%', marginRight: '6px' }}></span>Confidence Margin</span>
              </div>

              <div style={{ marginTop: '20px', padding: '14px', background: 'rgba(10,15,26,0.4)', borderRadius: '12px', border: '1px solid var(--border-subtle)' }}>
                <div style={{ fontSize: '13px', color: 'var(--text-main)', fontWeight: 600 }}>
                  Estimated Extractable Volume: <span style={{ color: 'var(--amber-400)', fontSize: '16px', fontWeight: 700 }}>41.2 kg / hive</span>
                </div>
                <div style={{ fontSize: '12px', color: 'var(--text-muted)', marginTop: '2px' }}>
                  Projected Fair Trade Farmer Revenue: ₹18,540 per hive super
                </div>
              </div>
            </div>
          </div>
        </section>

        {/* ================= 4. BLOCKCHAIN TRACE VIEW ================= */}
        <section className={`view-pane ${activeView === 'chain' ? 'active' : ''}`} id="view-chain">
          <div className="flow-title-row">
            <div className="eyebrow-badge"><Layers size={13} /> Permissioned Blockchain Ledger</div>
            <h2 style={{ fontSize: '30px' }}>Immutable Batch Traceability</h2>
            <p className="section-lede">
              Every stage from apiary extraction to lab NMR screening and packaging writes an SHA-256 hash-linked record to the Honey Chain ledger.
            </p>
          </div>

          <div className="trace-search-bar">
            <input
              type="text"
              className="search-input-field"
              value={batchIdInput}
              onChange={e => setBatchIdInput(e.target.value)}
              placeholder="Enter Batch ID (e.g. KVIC-HC-2026-0417)"
            />
            <button className="btn-luxury btn-luxury-primary" onClick={() => alert(`Batch ${batchIdInput} successfully verified on Honey Chain ledger!`)}>
              <ShieldCheck size={16} /> Verify Batch Chain
            </button>
          </div>

          <div className="merkle-chain-scroll">
            {sharedBatches.find(b => b.id === batchIdInput) ? (
              sharedBatches.find(b => b.id === batchIdInput).transactions.map((tx, i, arr) => (
                <React.Fragment key={i}>
                  <div className="blockchain-node-card">
                    <div className="b-tag">{new Date(tx.date).toLocaleString()}</div>
                    <div className="b-title" style={{ color: 'var(--amber-400)' }}>{tx.event}</div>
                    <div className="b-detail">Actor: {tx.actor}</div>
                    <div className="b-detail">Batch ID: {batchIdInput}</div>
                    <div className="b-hash-pill" style={{ overflow: 'hidden', textOverflow: 'ellipsis' }}>TX-{Math.random().toString(36).substr(2, 10).toUpperCase()}</div>
                  </div>
                  {i < arr.length - 1 && (
                    <div className="flow-conduit">
                      <ChevronRight size={22} />
                    </div>
                  )}
                </React.Fragment>
              ))
            ) : (
              <div style={{ color: 'var(--text-muted)' }}>Enter a valid Batch ID (e.g., from the Overview) to view trace.</div>
            )}
          </div>

          <div style={{ display: 'flex', alignItems: 'center', gap: '8px', color: 'var(--emerald-400)', fontWeight: 600, fontSize: '13.5px', marginTop: '16px' }}>
            <CheckCircle2 size={18} />
            <span>Cryptographic Merkle Integrity Verified — 6 out of 6 blocks validated with zero hash discrepancy.</span>
          </div>
        </section>

        {/* ================= 5. CONSUMER SCAN VIEW ================= */}
        <section className={`view-pane ${activeView === 'qr' ? 'active' : ''}`} id="view-qr">
          <div className="flow-title-row">
            <div className="eyebrow-badge"><Search size={13} /> Direct Consumer Provenance</div>
            <h2 style={{ fontSize: '30px' }}>Scan the Jar • Verify the Honey Origin</h2>
            <p className="section-lede">
              Consumers scan the serialized QR code to instantly verify NMR purity, single-apiary GPS provenance, and direct farmer fair-trade support.
            </p>
          </div>

          <div className="qr-scanner-grid">
            {/* Left QR Code Card */}
            <div className="qr-generator-card">
              <div className="qr-display-frame">
                <QRCodeCanvas
                  value={`http://localhost:3000/verify/${batchIdInput}`}
                  size={180}
                  level="H"
                />
              </div>
              <div style={{ fontSize: '13px', color: 'var(--text-muted)', marginTop: '16px' }}>
                Serialized Batch ID: <strong style={{ color: 'var(--amber-400)' }}>{batchIdInput}</strong>
              </div>
              <button
                className="btn-luxury btn-luxury-primary"
                style={{ width: '100%', marginTop: '18px' }}
                onClick={() => setIsScanned(true)}
              >
                <Search size={16} /> Simulate Consumer Scan
              </button>
            </div>

            {/* Right Passport Result */}
            <div className={`passport-result-card ${isScanned ? 'active' : ''}`}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', flexWrap: 'wrap', gap: '10px' }}>
                <span className="status-beacon" style={{ padding: '6px 14px', fontSize: '12.5px' }}>
                  <CheckCircle2 size={15} /> 100% Authentic &amp; Verified Pure
                </span>
                <button
                  className="btn-luxury btn-luxury-ghost"
                  style={{ fontSize: '12.5px', padding: '6px 12px' }}
                  onClick={() => setShowFullCertModal(true)}
                >
                  <FileCheck size={14} /> View Digital Certificate
                </button>
              </div>

              <div className="passport-meta-grid">
                <div className="p-item"><div className="p-key">Origin Beekeeper</div><div className="p-val">Ganesh Pawar</div></div>
                <div className="p-item"><div className="p-key">Apiary Cluster</div><div className="p-val">Satara Cluster • Box H001</div></div>
                <div className="p-item"><div className="p-key">Harvest Timestamp</div><div className="p-val">14 Apr 2026 (Unheated)</div></div>
                <div className="p-item"><div className="p-key">Floral Spectrum</div><div className="p-val">Forest Multifloral (84% Pollen)</div></div>
                <div className="p-item"><div className="p-key">NMR Purity Score</div><div className="p-val" style={{ color: 'var(--emerald-400)' }}>98.6% (Raw Pure Honey)</div></div>
                <div className="p-item"><div className="p-key">C4 Foreign Sugars</div><div className="p-val" style={{ color: 'var(--emerald-400)' }}>NEGATIVE (0.0% Added)</div></div>
              </div>

              {/* Origin Map Component */}
              <div style={{ background: 'rgba(10,15,26,0.45)', border: '1px solid var(--border-subtle)', borderRadius: '14px', padding: '16px' }}>
                <div style={{ fontSize: '12px', color: 'var(--text-muted)', fontWeight: 600, marginBottom: '8px' }}>
                  <MapPin size={13} style={{ display: 'inline', marginRight: '4px' }} />
                  GEO-LOCATION VERIFIED ORIGIN — SATARA APIARY, MAHARASHTRA
                </div>
                <svg viewBox="0 0 300 80" width="100%" height="80">
                  {[[40, 25], [70, 45], [100, 18], [130, 48], [160, 30], [190, 52], [220, 22], [250, 40], [270, 18]].map(([x, y], i) => (
                    <circle key={i} cx={x} cy={y} r="3" fill="var(--border-highlight)" />
                  ))}
                  <circle cx="130" cy="48" r="7" fill="var(--amber-400)" />
                  <circle cx="130" cy="48" r="12" fill="none" stroke="var(--amber-400)" strokeWidth="1.5" opacity="0.5" />
                  <text x="130" y="70" fontSize="11" fill="var(--amber-400)" textAnchor="middle" fontFamily="JetBrains Mono">H001 · Satara (17.68° N, 74.01° E)</text>
                </svg>
              </div>

              {/* Timeline Component for Consumer */}
              <div className="consumer-timeline" style={{ marginTop: '24px', padding: '16px', background: 'rgba(0,0,0,0.2)', border: '1px solid var(--border-subtle)', borderRadius: '12px' }}>
                <h4 style={{ marginBottom: '16px', color: 'var(--amber-400)', fontSize: '13px', letterSpacing: '0.05em' }}>TRACEABILITY JOURNEY</h4>
                {sharedBatches.find(b => b.id === batchIdInput) ? (
                  sharedBatches.find(b => b.id === batchIdInput).transactions.map((tx, i) => (
                    <div key={i} style={{ display: 'flex', alignItems: 'flex-start', gap: '12px', marginBottom: '12px' }}>
                      <CheckCircle2 size={16} color="var(--emerald-400)" style={{ marginTop: '2px' }} />
                      <div>
                        <div style={{ fontSize: '13px', fontWeight: 600 }}>{tx.event}</div>
                        <div style={{ fontSize: '11px', color: 'var(--text-muted)' }}>{new Date(tx.date).toLocaleDateString()} • {tx.actor}</div>
                      </div>
                    </div>
                  ))
                ) : (
                  <div style={{ fontSize: '12px', color: 'var(--text-muted)' }}>Enter a valid serialized Batch ID in Blockchain Trace view.</div>
                )}
              </div>
            </div>
          </div>
        </section>

        {/* ================= 6. SCALE-UP VIEW ================= */}
        <section className={`view-pane ${activeView === 'scale' ? 'active' : ''}`} id="view-scale">
          <div className="flow-title-row">
            <div className="eyebrow-badge"><TrendingUp size={13} /> National KVIC Rollout Framework</div>
            <h2 style={{ fontSize: '30px' }}>Phased Deployment Across Rural Clusters</h2>
            <p className="section-lede">
              Structured scaling plan enabling KVIC to bundle IoT sensor kits with subsidized bee boxes across Western, Northern, and Eastern honey belts.
            </p>
          </div>

          <div className="phases-3col-grid">
            <div className="phase-roadmap-card">
              <div style={{ fontFamily: 'JetBrains Mono', fontSize: '11.5px', color: 'var(--amber-400)', fontWeight: 700 }}>PHASE 1 • MONTHS 0–6</div>
              <h3 style={{ fontSize: '20px', marginTop: '6px' }}>Pilot Apiary Clusters</h3>
              <p style={{ fontSize: '13px', color: 'var(--text-muted)', marginTop: '10px', lineHeight: '1.6' }}>
                50 smart hives deployed across Satara &amp; Kolhapur. Validates LoRaWAN uptime, AI acoustic models, and consumer QR engagement in 3 retail stores.
              </p>
            </div>
            <div className="phase-roadmap-card">
              <div style={{ fontFamily: 'JetBrains Mono', fontSize: '11.5px', color: 'var(--amber-400)', fontWeight: 700 }}>PHASE 2 • MONTHS 6–18</div>
              <h3 style={{ fontSize: '20px', marginTop: '6px' }}>Regional Expansion</h3>
              <p style={{ fontSize: '13px', color: 'var(--text-muted)', marginTop: '10px', lineHeight: '1.6' }}>
                500 smart hives across Maharashtra, Punjab &amp; Bihar honey corridors. Introduces cold-chain batch pooling and automated lab NMR verification.
              </p>
            </div>
            <div className="phase-roadmap-card">
              <div style={{ fontFamily: 'JetBrains Mono', fontSize: '11.5px', color: 'var(--amber-400)', fontWeight: 700 }}>PHASE 3 • MONTHS 18–36</div>
              <h3 style={{ fontSize: '20px', marginTop: '6px' }}>National Integration</h3>
              <p style={{ fontSize: '13px', color: 'var(--text-muted)', marginTop: '10px', lineHeight: '1.6' }}>
                Full integration with the national KVIC Honey Mission registry, bundling smart sensor toolkits directly into bee box welfare distribution.
              </p>
            </div>
          </div>

          {/* Hexagonal Cluster Network */}
          <div style={{ marginTop: '48px' }}>
            <div className="eyebrow-badge">CLUSTER COVERAGE MAP</div>
            <div className="hex-cluster-network">
              {clusters.map((c, i) => (
                <div key={c} className="hex-node-item">
                  <svg viewBox="0 0 52 54" width="52" height="54">
                    <path d={hexPath} fill={i < 3 ? 'var(--amber-500)' : 'rgba(245,158,11,0.18)'} stroke="var(--border-highlight)" strokeWidth="1.4" />
                  </svg>
                  <span>{c}</span>
                </div>
              ))}
            </div>
          </div>
        </section>

      </main>

      {/* ================= INTEGRATED FULL CERTIFICATE MODAL ================= */}
      {showFullCertModal && (
        <div className="modal-backdrop-blur" onClick={() => setShowFullCertModal(false)}>
          <div className="passport-modal-window" onClick={e => e.stopPropagation()}>
            <button className="btn-close-modal" onClick={() => setShowFullCertModal(false)}>✕</button>
            
            <div style={{ textAlign: 'center', marginBottom: '22px' }}>
              <span className="status-beacon" style={{ marginBottom: '8px' }}>
                <CheckCircle2 size={14} /> KVIC HONEY MISSION VERIFIED
              </span>
              <h2 style={{ fontSize: '26px', color: 'var(--text-main)', marginTop: '8px' }}>Digital Provenance Passport</h2>
              <p style={{ fontSize: '13px', color: 'var(--text-muted)' }}>
                Certified Single-Apiary Raw Honey • Tamper-Proof Cryptographic Record
              </p>
            </div>

            <div style={{ background: 'rgba(10,15,26,0.45)', border: '1px solid var(--border-highlight)', borderRadius: '16px', padding: '18px', marginBottom: '16px' }}>
              <div style={{ fontWeight: 700, fontSize: '14px', color: 'var(--amber-400)', marginBottom: '10px' }}>
                🔬 Referral Lab Analysis &amp; NMR Purity
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px dashed var(--border-subtle)', fontSize: '13.5px' }}>
                <span>NMR Purity Score:</span>
                <strong style={{ color: 'var(--emerald-400)' }}>98.6% (Pass ≥ 98.0%)</strong>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px dashed var(--border-subtle)', fontSize: '13.5px' }}>
                <span>Moisture Content:</span>
                <strong style={{ color: 'var(--emerald-400)' }}>17.2% (Pass ≤ 20.0%)</strong>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px dashed var(--border-subtle)', fontSize: '13.5px' }}>
                <span>C4 Foreign Sugar Test:</span>
                <strong style={{ color: 'var(--emerald-400)' }}>NEGATIVE (0.0% Added)</strong>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px dashed var(--border-subtle)', fontSize: '13.5px' }}>
                <span>Pollen Dominance:</span>
                <strong>84% Forest Multifloral Pollen</strong>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', fontSize: '13.5px' }}>
                <span>Antibiotics &amp; Heavy Metals:</span>
                <strong style={{ color: 'var(--emerald-400)' }}>NOT DETECTED (0.0 ppm)</strong>
              </div>
            </div>

            <div style={{ background: 'rgba(10,15,26,0.45)', border: '1px solid var(--border-subtle)', borderRadius: '16px', padding: '18px', marginBottom: '20px' }}>
              <div style={{ fontWeight: 700, fontSize: '14px', color: 'var(--amber-400)', marginBottom: '10px' }}>
                👨‍🌾 Rural Beekeeper Origin
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px dashed var(--border-subtle)', fontSize: '13.5px' }}>
                <span>Beekeeper Name:</span>
                <strong>Ganesh Pawar</strong>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px dashed var(--border-subtle)', fontSize: '13.5px' }}>
                <span>KVIC Bee Box ID:</span>
                <strong className="mono">H001 • Satara</strong>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', borderBottom: '1px dashed var(--border-subtle)', fontSize: '13.5px' }}>
                <span>Harvest Date:</span>
                <strong>14 Apr 2026</strong>
              </div>
              <div style={{ display: 'flex', justifyContent: 'space-between', padding: '6px 0', fontSize: '13.5px' }}>
                <span>Extraction Method:</span>
                <strong>Cold Centrifugal Spin (Raw &amp; Unheated)</strong>
              </div>
            </div>

            <button
              className="btn-luxury btn-luxury-primary"
              style={{ width: '100%' }}
              onClick={() => alert('Official KVIC Honey Mission Provenance Certificate downloaded successfully!')}
            >
              📥 Download Official Provenance Certificate
            </button>
          </div>
        </div>
      )}

      {/* Footer */}
      <footer className="app-footer">
        <div className="wrap">
          Honey Chain • Blockchain Honey Traceability &amp; Smart Beekeeping Platform for KVIC Honey Mission
        </div>
      </footer>
    </div>
  );
}