                  <div className="bm-label">Quality:</div>
                  <div className="bm-val verify-text">✓ {latestBatch.qualityStatus}</div>
                  
                  <div className="bm-label">Blockchain:</div>
                  <div className="bm-val verify-text">✓ {latestBatch.blockchainStatus}</div>
                </div>

                <button className="btn-luxury btn-luxury-primary" style={{ width: '100%', marginTop: '16px' }} onClick={(e) => { e.stopPropagation(); switchView('chain'); setBatchIdInput(latestBatch.id); }}>
                  View Full Trace →
                </button>
              </div>
            </div>
            </div>
          </>
          )}
        </section>

        {/* ================= 2. HIVE MONITOR VIEW ================= */}
        <section className={`view-pane ${activeView === 'monitor' ? 'active' : ''}`} id="view-monitor">
          <div className="monitor-dashboard-layout">
            
            {/* 1. LEFT SIDEBAR — HIVES */}
            <div className="monitor-sidebar">
              <div className="ms-search-wrap">
                <Search size={14} className="ms-search-icon" />
                <input type="text" className="ms-search-input" placeholder="Search Hive ID/location..." />
              </div>
              
              <div className="ms-hive-list">
                {[
                  { id: 'H001', loc: 'Satara, MH', status: 'Online' },
                  { id: 'H002', loc: 'Pune, MH', status: 'Online' },
                  { id: 'H003', loc: 'Nashik, MH', status: 'Online' },
                  { id: 'H004', loc: 'Kolhapur, MH', status: 'Offline' },
                  { id: 'H005', loc: 'Solapur, MH', status: 'Online' }
                ].map(h => (
                  <div key={h.id} className={`ms-hive-item ${h.id === activeHive ? 'active' : ''}`} onClick={() => setActiveHive(h.id)}>
                    <div className="ms-h-top">
                      <span className="ms-h-id">{h.id}</span>
                      <span className={`ms-h-status ${h.status.toLowerCase()}`}>● {h.status}</span>
                    </div>
                    <div className="ms-h-loc">{h.loc}</div>
                  </div>
