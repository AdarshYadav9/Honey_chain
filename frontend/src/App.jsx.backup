                <button onClick={() => { setCurrentUser(null); setActiveView('overview'); }} style={{ background: 'none', border: 'none', color: 'var(--amber-500)', cursor: 'pointer', textDecoration: 'underline' }}>Logout</button>
              </div>
            )}
            <div className="header-live-pill">
              <span className="beacon-dot"></span>
              <span>LIVE</span>
            </div>
            <button
              className="theme-toggle-btn"
              title={`Switch to ${theme === 'dark' ? 'Light' : 'Dark'} Mode`}
