                Honey Chain connects rural beekeepers, smart hives, AI analytics and blockchain traceability into one trusted honey ecosystem.
              </p>
              <div className="hero-cta-row">
                <button className="btn-luxury btn-luxury-primary" onClick={() => { switchView('monitor'); setActiveHive('HIVE-BOX-01'); }}>
                  <Settings size={16} /> Open Hive Telemetry
                </button>
                <button className="btn-luxury btn-luxury-ghost" onClick={() => switchView('qr')}>
                  <Search size={16} /> Try Consumer Scanner
                </button>
              </div>
            </div>

            {/* Floating Live Hive Badge */}
            <div className="live-hive-badge-wrap">
              <div className="live-hive-badge">
                <div className="live-badge-top">
                  <div className="live-badge-meta">
                    <div className="hive-code">SMART HIVE • H001</div>
                    <div className="hive-loc-title">Satara Apiary Cluster, MH</div>
                  </div>
                  <span className="status-beacon">
                    <span className="beacon-dot"></span> HEALTHY
                  </span>
                </div>

                <div className="telemetry-vitals-grid">
                  <div className="vital-cell clickable" onClick={() => setActivePopover('temp')}>
                    <div className="vital-lbl"><Thermometer size={14} /> Temperature</div>
                    <div className="vital-val">{(curHive.temp || 34.0).toFixed(1)} <span className="vital-unit">°C</span></div>
                  </div>
                  <div className="vital-cell clickable" onClick={() => setActivePopover('hum')}>
                    <div className="vital-lbl"><Droplets size={14} /> Brood Humidity</div>
                    <div className="vital-val">{Math.round(curHive.hum || 60)} <span className="vital-unit">%</span></div>
                  </div>
                  <div className="vital-cell clickable" onClick={() => setActivePopover('wt')}>
                    <div className="vital-lbl"><Scale size={14} /> Hive Weight</div>
                    <div className="vital-val">{(curHive.wt || 30.0).toFixed(1)} <span className="vital-unit">kg</span></div>
                  </div>
                  <div className="vital-cell clickable" onClick={() => setActivePopover('act')}>
                    <div className="vital-lbl"><Radio size={14} /> Acoustic Buzz</div>
                    <div className={`vital-val ${curHive.state === 'ok' ? 'vital-status-ok' : ''}`}>{curHive.act ? curHive.act.split(' ')[0] : 'Normal'}</div>
                  </div>
                  <div className="vital-cell clickable" onClick={() => setActivePopover('batt')}>
                    <div className="vital-lbl"><Battery size={14} /> Battery Pack</div>
                    <div className="vital-val">{Math.round(curHive.batt || 80)} <span className="vital-unit">%</span></div>
                  </div>
                  <div className="vital-cell clickable" onClick={() => setActivePopover('sync')}>
                    <div className="vital-lbl"><Activity size={14} /> Live Sync</div>
                    <div className="vital-val vital-sync-live">12s ago</div>
                  </div>
                </div>

                {activePopover && (
                  <div className="metric-popover">
                    <button className="popover-close" onClick={() => setActivePopover(null)}>×</button>
                    {activePopover === 'temp' && (
                      <>
                        <h4 style={{ margin: '0 0 10px', fontSize: '13px', textTransform: 'uppercase', letterSpacing: '0.05em' }}>Temperature</h4>
                        <div style={{ fontSize: '13px', marginBottom: '4px' }}>Current: {(curHive.temp || 34.0).toFixed(1)} °C</div>
                        <div style={{ fontSize: '13px', marginBottom: '4px', color: 'var(--text-muted)' }}>24H Range: 33.2 – 35.1 °C</div>
                        <div style={{ fontSize: '13px', marginBottom: '12px', color: curHive.state === 'warn' ? 'var(--amber-400)' : 'var(--emerald-400)' }}>Status: {curHive.state === 'warn' ? 'High' : 'Normal'}</div>
                        <button className="btn-luxury btn-luxury-ghost popover-btn" onClick={() => { setActivePopover(null); switchView('monitor'); setActiveHive('HIVE-BOX-01'); }}>View Hive Monitor</button>
                      </>
                    )}
                    {activePopover === 'hum' && (
                      <>
                        <h4 style={{ margin: '0 0 10px', fontSize: '13px', textTransform: 'uppercase', letterSpacing: '0.05em' }}>Brood Humidity</h4>
                        <div style={{ fontSize: '13px', marginBottom: '4px' }}>Current: {Math.round(curHive.hum || 60)} %</div>
                        <div style={{ fontSize: '13px', marginBottom: '4px', color: 'var(--text-muted)' }}>24H Range: 58 – 65 %</div>
                        <div style={{ fontSize: '13px', marginBottom: '12px', color: 'var(--emerald-400)' }}>Status: Optimal</div>
                        <button className="btn-luxury btn-luxury-ghost popover-btn" onClick={() => { setActivePopover(null); switchView('monitor'); setActiveHive('HIVE-BOX-01'); }}>View Hive Monitor</button>
                      </>
                    )}
                    {activePopover === 'wt' && (
                      <>
                        <h4 style={{ margin: '0 0 10px', fontSize: '13px', textTransform: 'uppercase', letterSpacing: '0.05em' }}>Hive Weight</h4>
                        <div style={{ fontSize: '13px', marginBottom: '4px' }}>Current: {(curHive.wt || 30.0).toFixed(1)} kg</div>
                        <div style={{ fontSize: '13px', marginBottom: '4px', color: 'var(--text-muted)' }}>24H Change: +1.2 kg</div>
                        <div style={{ fontSize: '13px', marginBottom: '12px', color: 'var(--emerald-400)' }}>Trend: Increasing</div>
                        <button className="btn-luxury btn-luxury-ghost popover-btn" onClick={() => { setActivePopover(null); switchView('monitor'); setActiveHive('HIVE-BOX-01'); }}>View Hive Monitor</button>
                      </>
                    )}
                    {activePopover === 'act' && (
                      <>
                        <h4 style={{ margin: '0 0 10px', fontSize: '13px', textTransform: 'uppercase', letterSpacing: '0.05em' }}>Acoustic Buzz</h4>
                        <div style={{ fontSize: '13px', marginBottom: '4px' }}>Current: {curHive.act ? curHive.act.split(' ')[0] : 'Normal'}</div>
                        <div style={{ fontSize: '13px', marginBottom: '4px', color: 'var(--text-muted)' }}>Activity Index: 82</div>
                        <div style={{ fontSize: '13px', marginBottom: '12px', color: curHive.act && curHive.act.includes('Elevated') ? 'var(--amber-400)' : 'var(--emerald-400)' }}>Status: {curHive.act && curHive.act.includes('Elevated') ? 'Swarm Risk' : 'Normal'}</div>
                        <button className="btn-luxury btn-luxury-ghost popover-btn" onClick={() => { setActivePopover(null); switchView('monitor'); setActiveHive('HIVE-BOX-01'); }}>View Hive Monitor</button>
                      </>
                    )}
                    {activePopover === 'batt' && (
                      <>
                        <h4 style={{ margin: '0 0 10px', fontSize: '13px', textTransform: 'uppercase', letterSpacing: '0.05em' }}>Battery Pack</h4>
                        <div style={{ fontSize: '13px', marginBottom: '4px' }}>Current: {Math.round(curHive.batt || 80)} %</div>
                        <div style={{ fontSize: '13px', marginBottom: '4px', color: 'var(--text-muted)' }}>Remaining: ~42 Days</div>
                        <div style={{ fontSize: '13px', marginBottom: '12px', color: curHive.batt < 20 ? 'var(--rose-400)' : 'var(--emerald-400)' }}>Status: {curHive.batt < 20 ? 'Low Battery' : 'Healthy'}</div>
                        <button className="btn-luxury btn-luxury-ghost popover-btn" onClick={() => { setActivePopover(null); switchView('monitor'); setActiveHive('HIVE-BOX-01'); }}>View Hive Monitor</button>
                      </>
                    )}
                    {activePopover === 'sync' && (
                      <>
                        <h4 style={{ margin: '0 0 10px', fontSize: '13px', textTransform: 'uppercase', letterSpacing: '0.05em' }}>Live Sync</h4>
                        <div style={{ fontSize: '13px', marginBottom: '4px' }}>Last Update: 12s ago</div>
                        <div style={{ fontSize: '13px', marginBottom: '4px', color: 'var(--text-muted)' }}>Node: Satara-GW-01</div>
                        <div style={{ fontSize: '13px', marginBottom: '12px', color: 'var(--emerald-400)' }}>Connection: Stable (LoRaWAN)</div>
                        <button className="btn-luxury btn-luxury-ghost popover-btn" onClick={() => { setActivePopover(null); switchView('monitor'); setActiveHive('HIVE-BOX-01'); }}>View Hive Monitor</button>
                      </>
                    )}
                  </div>
                )}
              </div>
            </div>
          </div>

          {/* End-to-End Flow */}
          <div className="flow-container">
